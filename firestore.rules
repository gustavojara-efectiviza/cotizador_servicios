rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // COTIZACIONES V2 — Acceso para usuarios autenticados
    // Permite consultar cotizaciones históricas y nuevas creadas por el equipo.
    // =========================================================================
    match /cotizaciones_v2/{docId} {
      allow read, write: if request.auth != null;
    }

    // =========================================================================
    // COTIZACIONES EMITIDAS — Colección legacy (solo lectura para propietarios)
    // Mantener para no romper acceso a historial anterior.
    // =========================================================================
    match /cotizaciones_emitidas/{docId} {
      allow read, write: if request.auth != null;
    }

    // =========================================================================
    // EQUIPOS MAESTROS — Catálogo compartido de solo lectura
    // Cualquier usuario autenticado puede leer.
    // Cualquier usuario autenticado puede agregar (para el flujo ad-hoc).
    // Solo admins deberían poder eliminar (implementar con Custom Claims si se requiere).
    // =========================================================================
    match /equipos_maestros/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null; // Restringir a admins en el futuro
    }

    // =========================================================================
    // DENY ALL — Cualquier otra colección está bloqueada por defecto
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
